# Create an isolated Supabase project. Never point this at another production application.
SUPABASE_URL=
# Server-only privileged API key (sb_secret_... or legacy service_role). Do not prefix NEXT_PUBLIC_!
SUPABASE_SECRET_KEY=
# Server-side secret for pseudonymous rate-limit hashing; generate 32+ random bytes.
ABUSE_HASH_SECRET=
# Resend transactional email settings. Sender domain must be verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SALES_NOTIFY_EMAIL=
# Public support email published in footer and legal docs.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional webhook verification secret for Lemon Squeezy (live checkout is gated until activation)
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Canonical domain for link generation; no need to buy custom domain initially
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave false until hosted checkout, test-mode webhooks, correct tenant binding,
# and actual merchant approval have all been verified.
BILLING_LIVE_ENABLED=false
